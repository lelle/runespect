{
  "name": "runespect-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:playground": "pnpm --filter playground dev",
    "dev:spa": "pnpm --filter sveltekit-spa dev",
    "site:build": "pnpm --filter site build",
    "site:preview": "node e2e/serve-site.ts",
    "test": "pnpm -r --if-present test",
    "test:scripts": "vitest run --project scripts",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r --if-present build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "dupcheck": "jscpd packages",
    "e2e": "playwright test",
    "test:hmr": "node e2e/hmr-survival.ts",
    "test:extension": "node e2e/extension-events.ts",
    "test:pack": "node e2e/pack-install.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm -r test && pnpm test:scripts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
