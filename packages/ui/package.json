{
  "name": "@runespect/ui",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "Svelte 5 DevTools: runespect's panel and in-page overlay for the component tree and live runes state.",
  "keywords": [
    "svelte",
    "svelte5",
    "devtools",
    "svelte-devtools",
    "runes",
    "inspector",
    "state",
    "debugger",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelle/runespect.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/lelle/runespect#readme",
  "bugs": {
    "url": "https://github.com/lelle/runespect/issues"
  },
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "svelte": "./src/internal.ts",
      "default": "./src/internal.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "svelte": "./dist/internal.js",
        "default": "./dist/internal.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@runespect/agent": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.20.5"
  },
  "devDependencies": {
    "svelte": "5.57.3"
  }
}
